<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.1.1</Version>
    <PublicationBaselineVerifiedUtc>2026-11-12T15:17:36Z</PublicationBaselineVerifiedUtc>
    <Authors>Robert Prokopczuk</Authors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Keep SDK Source Link roots aligned with the unconditional compiler PathMap locally and in CI. -->
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>
  <!-- Verified through nuget.org during preparation; build and pack never query the feed. -->
  <ItemGroup Label="PublicationBaseline">
    <PublicationBaselinePackage Include="Inceptus.DiagramEngine.Contracts" State="Published" PublishedVersion="1.0.0" />
    <PublicationBaselinePackage Include="Inceptus.DiagramEngine.Runtime" State="Published" PublishedVersion="1.0.0" />
    <PublicationBaselinePackage Include="Inceptus.DiagramEngine.Bpmn" State="Published" PublishedVersion="1.0.0" />
    <PublicationBaselinePackage Include="Inceptus.DiagramEngine.Organizational" State="Published" PublishedVersion="1.0.0" />
    <PublicationBaselinePackage Include="Inceptus.DiagramEngine.Canvas2D" State="Published" PublishedVersion="1.0.0" />
    <PublicationBaselinePackage Include="Inceptus.DiagramEngine.Bpmn.Blazor" State="Published" PublishedVersion="1.0.0" />
    <PublicationBaselinePackage Include="Inceptus.Bpmn.Integration" State="Published" PublishedVersion="1.0.0" />
  </ItemGroup>
</Project>
