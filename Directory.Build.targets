<Project>
  <!-- Evaluate after each project declares packability; Demo and tests remain unpackaged. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Inceptus Robert Prokopczuk</Copyright>
    <PackageProjectUrl>https://inceptus.online/bpmn/editor/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/INCEPTUS-LABS/DiagramEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageIcon>inceptus-nuget-icon.png</PackageIcon>
    <!-- Source Link providers are included in the pinned .NET SDK. The actual
         checkout supplies the commit and source roots; never inject a release SHA. -->
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <UsingTask TaskName="ExtractPackageReleaseNotes" TaskFactory="RoslynCodeTaskFactory"
      AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll" Condition="'$(IsPackable)' == 'true'">
    <ParameterGroup>
      <NotesFile ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
      <PackageId ParameterType="System.String" Required="true" />
      <PublicationBaseline ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <ReleaseNotes ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        System.Version current;
        var family = new[] { "Inceptus.DiagramEngine.Contracts", "Inceptus.DiagramEngine.Runtime", "Inceptus.DiagramEngine.Bpmn",
            "Inceptus.DiagramEngine.Organizational", "Inceptus.DiagramEngine.Canvas2D", "Inceptus.DiagramEngine.Bpmn.Blazor", "Inceptus.Bpmn.Integration" };
        if (!Regex.IsMatch(Version, @"^[0-9]+\.[0-9]+\.[0-9]+$") || !System.Version.TryParse(Version, out current)
            || current < new System.Version(1, 0, 0)
            || !PublicationBaseline.Select(item => item.ItemSpec).OrderBy(id => id, StringComparer.Ordinal)
                .SequenceEqual(family.OrderBy(id => id, StringComparer.Ordinal))
            || !PublicationBaseline.Any(item => item.ItemSpec == PackageId))
        {
            Log.LogError("Invalid or inconsistent publication baseline for {0}.", Version);
            return false;
        }
        var initial = PublicationBaseline.Any(item => item.GetMetadata("State") == "NeverPublished");
        var predecessors = new System.Collections.Generic.List<string>();
        foreach (var item in PublicationBaseline)
        {
            var state = item.GetMetadata("State");
            var previous = item.GetMetadata("PublishedVersion");
            System.Version parsed;
            var valid = state == "NeverPublished"
                ? Version == "1.0.0" && item.ItemSpec != "Inceptus.Bpmn.Integration" && previous.Length == 0
                : state == "Published" && Regex.IsMatch(previous, @"^[0-9]+\.[0-9]+\.[0-9]+$")
                    && System.Version.TryParse(previous, out parsed) && parsed < current
                    && (initial ? item.ItemSpec == "Inceptus.Bpmn.Integration" && parsed < new System.Version(1, 0, 0)
                        : parsed >= new System.Version(1, 0, 0));
            if (!valid)
            {
                Log.LogError("Invalid publication baseline for {0}.", item.ItemSpec);
                return false;
            }
            if (state == "Published") predecessors.Add(previous);
        }
        if (initial ? predecessors.Count != 1 : predecessors.Distinct(StringComparer.Ordinal).Count() != 1)
        {
            Log.LogError("Invalid or inconsistent publication baseline for {0}.", Version);
            return false;
        }
        var packageBaseline = PublicationBaseline.Single(item => item.ItemSpec == PackageId);
        var neverPublished = packageBaseline.GetMetadata("State") == "NeverPublished";
        var baseline = neverPublished ? null : System.Version.Parse(packageBaseline.GetMetadata("PublishedVersion"));
        // The release workflow uses stable three-component versions. Keep section order and Markdown.
        // XML metadata normalizes line endings; the packaged historical file remains unchanged.
        var text = File.ReadAllText(NotesFile).Replace("\r\n", "\n").Replace("\r", "\n");
        var headings = Regex.Matches(text,
            @"(?m)^##[ \t]+(?<version>[0-9]+\.[^\s]+)(?:[ \t]+[^\n]*)?$");
        var selectedVersions = new System.Collections.Generic.HashSet<System.Version>();
        var notes = new StringBuilder();
        foreach (Match heading in headings)
        {
            var value = heading.Groups["version"].Value;
            System.Version sectionVersion;
            if (!Regex.IsMatch(value, @"^[0-9]+\.[0-9]+\.[0-9]+$") || !System.Version.TryParse(value, out sectionVersion))
            {
                Log.LogError("Invalid release notes version heading: {0}.", value);
                return false;
            }
            if (sectionVersion > current || (neverPublished ? sectionVersion != current : sectionVersion <= baseline)) continue;
            var next = headings.Cast<Match>().FirstOrDefault(candidate => candidate.Index > heading.Index);
            var end = next == null ? text.Length : next.Index;
            var bodyStart = heading.Index + heading.Length;
            if (!selectedVersions.Add(sectionVersion) || string.IsNullOrWhiteSpace(text.Substring(bodyStart, end - bodyStart)))
            {
                Log.LogError("Missing, empty or ambiguous release notes section: {0}.", value);
                return false;
            }
            notes.Append(text.Substring(heading.Index, end - heading.Index));
        }
        ReleaseNotes = notes.ToString().TrimEnd();
        if (!selectedVersions.Contains(current) || ReleaseNotes.Length == 0 || ReleaseNotes.Length > 35000)
        {
            Log.LogError("Cumulative release notes must include version {0} and contain between 1 and 35000 characters; found {1}.", Version, ReleaseNotes.Length);
            return false;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Run for pack with or without a build, before NuGet reads PackageReleaseNotes. -->
  <Target Name="SetPackageReleaseNotes" BeforeTargets="GenerateNuspec" Condition="'$(IsPackable)' == 'true'">
    <ExtractPackageReleaseNotes NotesFile="$(MSBuildThisFileDirectory)RELEASE-NOTES.md" Version="$(Version)"
        PackageId="$(PackageId)" PublicationBaseline="@(PublicationBaselinePackage)">
      <Output TaskParameter="ReleaseNotes" PropertyName="PackageReleaseNotes" />
    </ExtractPackageReleaseNotes>
  </Target>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)RELEASE-NOTES.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)branding/inceptus-nuget-icon.png"
        Pack="true"
        PackagePath="inceptus-nuget-icon.png" />
  </ItemGroup>
</Project>
